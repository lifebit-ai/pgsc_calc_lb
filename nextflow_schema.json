{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://raw.githubusercontent.com/lifebit-ai/pgsc_calc_lb/john_test_06/nextflow_schema.json",
  "title": "Cancer chromosome fan-out probe",
  "description": "Stage three cancer VCF/index pairs as independent Azure Batch tasks and publish metadata-only receipts.",
  "type": "object",
  "properties": {
    "input_vcf_chr01": {
      "type": "string",
      "format": "file-path",
      "exists": true,
      "description": "Chromosome 1 ML-filtered cancer cohort VCF."
    },
    "input_index_chr01": {
      "type": "string",
      "format": "file-path",
      "exists": true,
      "description": "Tabix index paired with input_vcf_chr01."
    },
    "input_vcf_chr20": {
      "type": "string",
      "format": "file-path",
      "exists": true,
      "description": "Chromosome 20 ML-filtered cancer cohort VCF."
    },
    "input_index_chr20": {
      "type": "string",
      "format": "file-path",
      "exists": true,
      "description": "Tabix index paired with input_vcf_chr20."
    },
    "input_vcf_chr22": {
      "type": "string",
      "format": "file-path",
      "exists": true,
      "description": "Chromosome 22 ML-filtered cancer cohort VCF."
    },
    "input_index_chr22": {
      "type": "string",
      "format": "file-path",
      "exists": true,
      "description": "Tabix index paired with input_vcf_chr22."
    },
    "outdir": {
      "type": "string",
      "format": "directory-path",
      "default": "results",
      "description": "Output directory for the three metadata-only receipts."
    }
  },
  "required": [
    "input_vcf_chr01",
    "input_index_chr01",
    "input_vcf_chr20",
    "input_index_chr20",
    "input_vcf_chr22",
    "input_index_chr22"
  ]
}

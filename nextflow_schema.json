{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://raw.githubusercontent.com/lifebit-ai/pgsc_calc_lb/chromosome_probe_01/nextflow_schema.json",
  "title": "Chromosome scale-out probe",
  "description": "Reserve one full worker per chromosome task and observe scheduler placement.",
  "type": "object",
  "definitions": {
    "input_options": {
      "title": "Required chromosome inputs",
      "type": "object",
      "description": "Select the three bgzip-compressed VCF and Tabix index pairs.",
      "properties": {
        "input_vcf_chr01": {
          "type": "string",
          "format": "file-path",
          "exists": true,
          "description": "Chromosome 1 bgzip-compressed VCF."
        },
        "input_index_chr01": {
          "type": "string",
          "format": "file-path",
          "exists": true,
          "description": "Tabix index paired with input_vcf_chr01."
        },
        "input_vcf_chr20": {
          "type": "string",
          "format": "file-path",
          "exists": true,
          "description": "Chromosome 20 bgzip-compressed VCF."
        },
        "input_index_chr20": {
          "type": "string",
          "format": "file-path",
          "exists": true,
          "description": "Tabix index paired with input_vcf_chr20."
        },
        "input_vcf_chr22": {
          "type": "string",
          "format": "file-path",
          "exists": true,
          "description": "Chromosome 22 bgzip-compressed VCF."
        },
        "input_index_chr22": {
          "type": "string",
          "format": "file-path",
          "exists": true,
          "description": "Tabix index paired with input_vcf_chr22."
        }
      },
      "required": [
        "input_vcf_chr01",
        "input_index_chr01",
        "input_vcf_chr20",
        "input_index_chr20",
        "input_vcf_chr22",
        "input_index_chr22"
      ]
    },
    "execution_options": {
      "title": "Execution options",
      "type": "object",
      "description": "Control the scale-out observation and receipt destination.",
      "properties": {
        "hold_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1800,
          "default": 1200,
          "description": "Controlled hold used to keep full-slot tasks pending long enough to observe scheduler placement."
        },
        "outdir": {
          "type": "string",
          "format": "directory-path",
          "default": "results",
          "description": "Output directory for the three validation receipts."
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/input_options"
    },
    {
      "$ref": "#/definitions/execution_options"
    }
  ]
}
